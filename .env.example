# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Browser (safe to expose) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Leave the two values above empty (or set this to true) to run in demo mode.
# VITE_DEMO_MODE=true

# --- Server only (Vercel functions). Never prefix these with VITE_. ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used to build OAuth redirect URLs. No trailing slash.
APP_URL=http://localhost:3000

# YouTube (Google Cloud console → OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok (developers.tiktok.com → app with Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Facebook + Instagram (developers.facebook.com → Business app)
META_APP_ID=
META_APP_SECRET=
# Optional: override the Graph API version
# META_GRAPH_VERSION=v23.0

# SoundCloud (apply for API access at soundcloud.com/you/apps)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Not needed yet: scheduled releases are off until a scheduler calls /api/cron/scheduled
# (see README). Then: any long random string, sent as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
