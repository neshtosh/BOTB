{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {
    "api/publish.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "api/cron/scheduled.ts": {
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "buildCommand": "VITE_DEMO_MODE=true npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
